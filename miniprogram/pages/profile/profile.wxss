.screen { padding: 48rpx 30rpx 190rpx; }
.eyebrow { color: #3478eb; font-size: 22rpx; font-weight: 700; letter-spacing: 4rpx; }
.title { margin-top: 12rpx; color: #182943; font-size: 48rpx; font-weight: 800; }
.profile-card { display: flex; align-items: center; gap: 20rpx; margin: 30rpx 0; padding: 26rpx; border-radius: 26rpx; color: white; background: linear-gradient(135deg,#3787f5,#2366db); }
.avatar { display: flex; align-items: center; justify-content: center; width: 95rpx; height: 95rpx; border-radius: 50%; color: #2473df; background: white; font-size: 35rpx; font-weight: 800; }
.name { font-size: 30rpx; font-weight: 750; }
.caption { margin-top: 7rpx; color: #93a2b7; font-size: 21rpx; }
.profile-card .caption { color: #dce9ff; }
.panel { margin-bottom: 19rpx; padding: 27rpx; border-radius: 24rpx; background: white; box-shadow: 0 7rpx 26rpx rgba(30,70,120,.04); }
.panel-title { color: #1d2d47; font-size: 27rpx; font-weight: 750; }
.name-edit { display: flex; align-items: center; gap: 15rpx; margin-top: 17rpx; }
.name-edit input { flex: 1; height: 64rpx; padding: 0 15rpx; border-radius: 12rpx; background: #f1f4f8; font-size: 25rpx; }
.name-edit view { padding: 13rpx 20rpx; border-radius: 13rpx; color: white; background: #2d79ef; font-size: 22rpx; }
.state { margin-top: 18rpx; color: #2d79ef; font-size: 34rpx; font-weight: 700; }
.count { float: right; color: #92a1b3; font-size: 22rpx; font-weight: 400; }
.favorite-row { display: flex; align-items: center; gap: 15rpx; padding: 19rpx 0; border-bottom: 1rpx solid #eef1f5; color: #334b69; font-size: 24rpx; }
.favorite-row view { flex: 1; }
.favorite-row text { font-size: 29rpx; }
.empty { margin-top: 18rpx; color: #9caabc; font-size: 22rpx; }
.privacy { display: flex; align-items: center; justify-content: space-between; }
.disclaimer { padding: 12rpx; color: #9ba9bb; font-size: 21rpx; line-height: 1.6; }
